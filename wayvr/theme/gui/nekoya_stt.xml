<layout version="2">
  <!--
    nekoya_stt — 字幕面板 + 主控面板

    - 面板默认隐藏；由 daemon 通过 IPC WlxOverlaySetVisible 显示（ensure-on，非 toggle）。
    - daemon 只 SetText/SetVisible 文字元素，绝不改 transform/positioning。
    - 所有 ShellExec 用绝对路径 /usr/bin/nekoya-stt。
    - id 约定（对应 src/hud.rs）：transcript / status / session / session_list / session_row_N（N<16），
      行内文本 label 为 session_row_N_text。

    会话列表行：行内放一个 <label> 承接文本（SetText 打 label，字号/高度可控，避免文字重叠）；
    行本身默认可见，由 daemon 对未使用的行发 SetVisible(false) 隐藏。
  -->
  <vars>
    <var key="_panel_icon" value="/home/EMeowSystem/.config/wayvr/theme/assets/opencode-wordmark.svg" />
  </vars>

  <macro name="bg" width="100%" color="background" border_color="outline" round="10" border="2" />
  <macro name="btn" border="2" round="6" align_items="center" justify_content="center" padding="6" width="64" height="64" overflow="visible" />
  <macro name="rowbtn" width="100%" height="30" border="1" round="4" padding="1" align_items="center" justify_content="center" />
  <macro name="sep" width="2" height="64" color="outline" round="1" />

  <elements>
    <div flex_direction="column" width="660" gap="6">

      <rectangle macro="bg" padding="10" flex_direction="column" gap="4">
        <label id="status" text="空闲" size="16" color="on_background_variant" />
        <label id="session" text="会话：（未选择）" size="16" color="on_background_variant" />
        <label id="transcript" wrap="1" size="20" text="" />
      </rectangle>

      <rectangle macro="bg" padding="10">
        <div gap="8" width="100%">
          <Button macro="btn" id="btn_ptt" tooltip_str="PTT"
            _press="::ShellExec /usr/bin/nekoya-stt act ptt-down"
            _release="::ShellExec /usr/bin/nekoya-stt act ptt-up">
            <sprite width="38" height="38" src_builtin="@/icons/mic.svg" />
          </Button>
          <rectangle macro="sep" />
          <Button macro="btn" id="btn_copy" tooltip_str="复制到剪贴板"
            _press="::ShellExec /usr/bin/nekoya-stt act copy">
            <sprite width="38" height="38" src_builtin="@/icons/paste.svg" />
          </Button>
          <Button macro="btn" id="btn_paste" tooltip_str="Ctrl+V"
            _press="::SendKey LCtrl down"
            _press2="::SendKey V down"
            _press3="::SendKey V up"
            _press4="::SendKey LCtrl up">
            <sprite width="38" height="38" src_builtin="@/icons/paste-go.svg" />
          </Button>
          <rectangle macro="sep" />
          <Button macro="btn" id="btn_enter" tooltip_str="回车"
            _press="::SendKey Return down"
            _release="::SendKey Return up">
            <sprite width="38" height="38" src_builtin="@/keyboard/return.svg" />
          </Button>
          <rectangle macro="sep" />
          <Button macro="btn" id="btn_osc" tooltip_str="VRChat OSC"
            _press="::ShellExec /usr/bin/nekoya-stt act osc">
            <sprite width="38" height="38" src_builtin="@/icons/chat.svg" />
          </Button>
          <div flex_grow="1" />
          <Button macro="btn" id="btn_push" tooltip_str="推送到 OpenCode"
            _press="::ShellExec /usr/bin/nekoya-stt act push">
            <sprite width="38" height="38" src="/home/EMeowSystem/.config/wayvr/theme/assets/opencode-wordmark.svg" />
          </Button>
          <Button macro="btn" id="btn_sessions" tooltip_str="会话列表"
            _press="::ShellExec /usr/bin/nekoya-stt act list">
            <sprite width="38" height="38" src_builtin="@/keyboard/burger.svg" />
          </Button>
        </div>
      </rectangle>

      <rectangle macro="bg" padding="6">
        <div id="session_list" display="none" flex_direction="column" overflow_y="scroll" height="420" gap="2">
          <Button macro="rowbtn" id="session_row_0" _press="::ShellExec /usr/bin/nekoya-stt act select 0">
            <label id="session_row_0_text" size="16" text="—" />
          </Button>
          <Button macro="rowbtn" id="session_row_1" _press="::ShellExec /usr/bin/nekoya-stt act select 1">
            <label id="session_row_1_text" size="16" text="—" />
          </Button>
          <Button macro="rowbtn" id="session_row_2" _press="::ShellExec /usr/bin/nekoya-stt act select 2">
            <label id="session_row_2_text" size="16" text="—" />
          </Button>
          <Button macro="rowbtn" id="session_row_3" _press="::ShellExec /usr/bin/nekoya-stt act select 3">
            <label id="session_row_3_text" size="16" text="—" />
          </Button>
          <Button macro="rowbtn" id="session_row_4" _press="::ShellExec /usr/bin/nekoya-stt act select 4">
            <label id="session_row_4_text" size="16" text="—" />
          </Button>
          <Button macro="rowbtn" id="session_row_5" _press="::ShellExec /usr/bin/nekoya-stt act select 5">
            <label id="session_row_5_text" size="16" text="—" />
          </Button>
          <Button macro="rowbtn" id="session_row_6" _press="::ShellExec /usr/bin/nekoya-stt act select 6">
            <label id="session_row_6_text" size="16" text="—" />
          </Button>
          <Button macro="rowbtn" id="session_row_7" _press="::ShellExec /usr/bin/nekoya-stt act select 7">
            <label id="session_row_7_text" size="16" text="—" />
          </Button>
          <Button macro="rowbtn" id="session_row_8" _press="::ShellExec /usr/bin/nekoya-stt act select 8">
            <label id="session_row_8_text" size="16" text="—" />
          </Button>
          <Button macro="rowbtn" id="session_row_9" _press="::ShellExec /usr/bin/nekoya-stt act select 9">
            <label id="session_row_9_text" size="16" text="—" />
          </Button>
          <Button macro="rowbtn" id="session_row_10" _press="::ShellExec /usr/bin/nekoya-stt act select 10">
            <label id="session_row_10_text" size="16" text="—" />
          </Button>
          <Button macro="rowbtn" id="session_row_11" _press="::ShellExec /usr/bin/nekoya-stt act select 11">
            <label id="session_row_11_text" size="16" text="—" />
          </Button>
          <Button macro="rowbtn" id="session_row_12" _press="::ShellExec /usr/bin/nekoya-stt act select 12">
            <label id="session_row_12_text" size="16" text="—" />
          </Button>
          <Button macro="rowbtn" id="session_row_13" _press="::ShellExec /usr/bin/nekoya-stt act select 13">
            <label id="session_row_13_text" size="16" text="—" />
          </Button>
          <Button macro="rowbtn" id="session_row_14" _press="::ShellExec /usr/bin/nekoya-stt act select 14">
            <label id="session_row_14_text" size="16" text="—" />
          </Button>
          <Button macro="rowbtn" id="session_row_15" _press="::ShellExec /usr/bin/nekoya-stt act select 15">
            <label id="session_row_15_text" size="16" text="—" />
          </Button>
        </div>
      </rectangle>

    </div>
  </elements>
</layout>
