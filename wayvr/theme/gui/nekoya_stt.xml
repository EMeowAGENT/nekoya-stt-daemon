<layout version="2">
  <!--
    nekoya_stt — 字幕面板 + 主控面板（模板，供手动复制到 ~/.config/wayvr/theme/gui/）

    - 默认隐藏；由 daemon 通过 IPC WlxOverlaySetVisible 显示（ensure-on，非 toggle）。
    - daemon 只 SetText/SetVisible 文字元素，绝不改 transform/positioning。
    - 所有 ShellExec 用绝对路径 /usr/bin/nekoya-stt（可执行文件安装位）。
    - 元素 id 需与 src/hud.rs 常量一致：transcript / status / session / session_list / session_row_N。
  -->
  <macro name="bg" width="100%" color="background" border_color="outline" round="10" border="2" />
  <macro name="btn" border="2" round="6" align_items="center" justify_content="center" padding="6" width="64" height="64" overflow="visible" />
  <macro name="rowbtn" width="100%" height="36" border="1" round="4" padding="4" align_items="center" justify_content="center" />

  <elements>
    <div flex_direction="column" width="660" gap="6">

      <rectangle macro="bg" padding="10" flex_direction="column" gap="4">
        <label id="status" text="空闲" size="16" color="faded" />
        <label id="session" text="会话：（未选择）" size="16" color="faded" />
        <label id="transcript" wrap="1" size="20" text="" />
      </rectangle>

      <rectangle macro="bg" padding="10">
        <div gap="8">
          <Button macro="btn" id="btn_ptt" tooltip="PTT"
            _press="::ShellExec /usr/bin/nekoya-stt act ptt-down"
            _release="::ShellExec /usr/bin/nekoya-stt act ptt-up">
            <sprite width="38" height="38" src_builtin="@/icons/mic.svg" />
          </Button>
          <Button macro="btn" id="btn_copy" tooltip="复制到剪贴板"
            _press="::ShellExec /usr/bin/nekoya-stt act copy">
            <sprite width="38" height="38" src_builtin="@/icons/paste.svg" />
          </Button>
          <Button macro="btn" id="btn_osc" tooltip="VRChat OSC"
            _press="::ShellExec /usr/bin/nekoya-stt act osc">
            <sprite width="38" height="38" src_builtin="@/icons/chat.svg" />
          </Button>
          <Button macro="btn" id="btn_paste" tooltip="Ctrl+V"
            _press="::SendKey LCtrl down"
            _press2="::SendKey V down"
            _press3="::SendKey V up"
            _press4="::SendKey LCtrl up">
            <sprite width="38" height="38" src_builtin="@/icons/paste-go.svg" />
          </Button>
          <Button macro="btn" id="btn_enter" tooltip="回车"
            _press="::SendKey Return down"
            _release="::SendKey Return up">
            <sprite width="38" height="38" src_builtin="@/keyboard/return.svg" />
          </Button>
          <Button macro="btn" id="btn_push" tooltip="推送到 OpenCode"
            _press="::ShellExec /usr/bin/nekoya-stt act push">
            <sprite width="38" height="38" src_builtin="@/icons/bell.svg" />
          </Button>
          <Button macro="btn" id="btn_sessions" tooltip="会话列表"
            _press="::ShellExec /usr/bin/nekoya-stt act list">
            <sprite width="38" height="38" src_builtin="@/icons/landscape.svg" />
          </Button>
        </div>
      </rectangle>

      <rectangle macro="bg" padding="6">
        <div id="session_list" display="none" flex_direction="column" overflow_y="scroll" height="320" gap="2">
          <Button macro="rowbtn" id="btn_close_list" text="关闭列表" _press="::ShellExec /usr/bin/nekoya-stt act list" />
          <Button macro="rowbtn" id="session_row_0" text="—" display="none" _press="::ShellExec /usr/bin/nekoya-stt act select 0" />
          <Button macro="rowbtn" id="session_row_1" text="—" display="none" _press="::ShellExec /usr/bin/nekoya-stt act select 1" />
