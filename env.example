# nekoya-stt 环境变量模板（systemd EnvironmentFile）
# 实际文件放 ~/.config/nekoya-stt/env，权限 600。
# 复制：mkdir -p ~/.config/nekoya-stt && cp env.example ~/.config/nekoya-stt/env && chmod 600 ~/.config/nekoya-stt/env

DASHSCOPE_API_KEY=sk-REPLACE_ME

# 可选覆盖（NEKOYA_* 前缀）
# NEKOYA_VRC_OSC_PORT=9000
# NEKOYA_OPENCODE_URL=http://127.0.0.1:49374
# NEKOYA_OPENCODE_PASSWORD=
# NEKOYA_MODEL=qwen3-asr-flash-realtime
# NEKOYA_WAYVR_ENABLED=false
